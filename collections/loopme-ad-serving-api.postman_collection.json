  "info": {
    "_postman_id": "3d6b127e-5f9a-4fd6-9ee5-bcf336ca3b5a",
    "name": "LoopMe S2S Ad Request API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "LoopMe server-to-server (S2S) ad request API. A publisher's ad server makes a GET request describing the device, app, and user, and LoopMe returns an ad payload (ad HTML in a script element plus beacon URLs) or an empty ads array when no ad is available. Requests are identified by the appId provided by LoopMe rather than a bearer token; the api_auth_token used by the Reporting API does not apply here.\n\nContact Support:\n Name: LoopMe Support",
      "type": "text/plain"
    }
  }
