          "name": "Request an ad",
          "request": {
            "name": "Request an ad",
            "description": {
              "content": "Requests an ad for the described device/app/user context. Returns an ad payload on success, an empty ads array when no ad is available, or an error object.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "appId",
                  "value": "<string>",
                  "description": "(Required) Unique application identifier provided by LoopMe."
                },
                {
                  "disabled": false,
                  "key": "ua",
                  "value": "<string>",
                  "description": "(Required) Device user agent string."
                },
                {
                  "disabled": false,
                  "key": "uid",
                  "value": "<string>",
                  "description": "(Required) Unique user identifier (IDFA, Google Advertiser ID, or cookie ID)."
                },
                {
                  "disabled": false,
                  "key": "ip",
                  "value": "<string>",
                  "description": "(Required) Device IP address."
                },
                {
                  "disabled": false,
                  "key": "clientid",
                  "value": "<string>",
                  "description": "(Required) Client server name, used for debugging."
                },
                {
                  "disabled": false,
                  "key": "dnt",
                  "value": "<integer>",
                  "description": "(Required) Do-not-track flag; 1 to disable tracking."
                },
                {
                  "disabled": false,
                  "key": "bundleid",
                  "value": "<string>",
                  "description": "(Required) App bundle ID from the store."
                },
                {
                  "disabled": false,
                  "key": "appname",
                  "value": "<string>",
                  "description": "(Required) Application name."
                },
                {
                  "disabled": false,
