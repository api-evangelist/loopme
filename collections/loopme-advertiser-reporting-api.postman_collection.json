          "name": "Retrieve advertiser (campaign) statistics",
          "request": {
            "name": "Retrieve advertiser (campaign) statistics",
            "description": {
              "content": "Returns campaign, line item, and creative statistics for the authenticated LoopMe advertiser account over the requested date range and granularity.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reports",
                "campaigns"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_auth_token",
                  "value": "<string>",
                  "description": "(Required) 16-character LoopMe API authentication token."
                },
                {
                  "disabled": false,
                  "key": "date_range",
                  "value": "<string>",
                  "description": "(Required) Predefined value (today, yesterday, days7, days30, days90) or a custom range in YYYY-MM-DD:YYYY-MM-DD format."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "Time bucketing for the series."
                },
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-3 country code (e.g. USA, GBR)."
                },
                {
                  "disabled": false,
                  "key": "platform",
                  "value": "<string>",
                  "description": "Platform filter."
                },
                {
                  "disabled": false,
                  "key": "group_by",
                  "value": "<string>",
                  "description": "Comma-separated list of dimensions to group results by."
                },
                {
                  "disabled": false,
                  "key": "campaign_id",
                  "value": "<integer>",
                  "description": "Integer campaign identifier."
                },
                {
                  "disabled": false,
                  "key": "line_item_id",
                  "value": "<integer>",
                  "description": "Integer line item identifier."
                },
                {
                  "disabled": false,
                  "key": "creative_id",
                  "value": "<integer>",
                  "description": "Integer creative identifier."
                }
              ],
              "variable": []
            },
